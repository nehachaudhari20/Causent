# Causent application
CAUSENT_ENV=development
CAUSENT_API_HOST=0.0.0.0
CAUSENT_API_PORT=8080

# Off-chain stores (prototype)
CAUSENT_DATABASE_URL=postgresql://causent:causent@localhost:5432/causent
CAUSENT_EVIDENCE_STORAGE_PATH=./data/evidence

# Drunix / Fabric gateway (fill after test-network bring-up)
DRUNIX_CHANNEL_NAME=causent-channel
DRUNIX_CHAINCODE_NAME=causent-assurance
DRUNIX_MSP_ID=AgentPlatformMSP
DRUNIX_PEER_ENDPOINT=localhost:7051
DRUNIX_TLS_ENABLED=true
DRUNIX_GATEWAY_ENABLED=false
